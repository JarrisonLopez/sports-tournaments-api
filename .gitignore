node_modules/
dist/
.env
coverage/
PROJECT_CONTEXT.md
.worktrees/

# AWS / chaos lab secrets and results
k8s/aws/secret.yaml
infra/aws/terraform/*.tfvars
!infra/aws/terraform/*.tfvars.example
chaos/results/**
!chaos/results/.gitkeep
!chaos/results/rounds-latest.json
!chaos/results/fixtures/
!chaos/results/fixtures/**
!chaos/results/chaos-toolkit-journal.json
chaostoolkit.log
lab/.runtime-lab.*
load/results/**
!load/results/.gitkeep
!load/results/baseline-k6-*.json
!load/results/r0-k6-*.json
!load/results/r1-k6-*.json
!load/results/k6-*-summary.json
lab/.runtime/

# Terraform local cache. .terraform.lock.hcl queda fuera de esta carpeta y se versiona.
.terraform/
infra/aws/terraform/.provider-mirror/
infra/aws/terraform/terraform.rc.lab
infra/aws/terraform/terraform.tfvars.plancheck
infra/aws/terraform/tfplan-lab.bin
infra/aws/terraform/plan-output.txt
infra/aws/terraform/plan-stdout.txt
infra/aws/terraform/plan-stderr.txt
infra/aws/terraform/apply-stdout.txt
infra/aws/terraform/apply-stderr.txt
infra/aws/.tools/
*.pem
!*.pem.example

# Estado local, copias de respaldo y bloqueo local de estado
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Variables reales. Los ejemplos sí se versionan.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Backend real. backend.hcl.example sí se versiona.
# .terraform.lock.hcl no coincide con este nombre.
backend.hcl
!backend.hcl.example

# Overrides locales
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Logs de fallos de Terraform
crash.log
crash.*.log

# Planes binarios. Pueden contener valores sensibles.
# .terraform.lock.hcl no entra en estos patrones y se versiona.
tfplan
tfplan.*
*.tfplan

# Artefactos locales del workflow de Provision (Python).
.venv-provision/
__pycache__/
*.pyc
