DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Identidad Canary (headers X-Api-Version / X-Api-Track). Vacío → "unset".
# No usar package.json. En Cloud Run: API_VERSION=3.0.1|4.0.0 y API_TRACK=stable|canary.
API_VERSION=
API_TRACK=

# Bootstrap de esquema. No lo ejecuta el arranque de la API.
# plan es de solo lectura. apply y adopt exigen --confirm con el mismo DB_NAME.
# DB_BOOTSTRAP_ALLOW_HOST valida el host TCP declarado y debe ser exactamente DB_HOST.
# DB_BOOTSTRAP_EXPECT_INSTANCE declara la instancia prevista: proyecto:region:instancia.
# Ninguna de las dos comprueba el destino remoto del Cloud SQL Auth Proxy.
# El workflow de GCP todavía no existe. Cuando exista, deberá exigir esta variable
# no vacía y comprobar por su cuenta el destino del Auth Proxy: fallar si no coinciden
# la configuración autorizada, los metadatos de la instancia y el argumento de arranque.
# CLOUD_SQL_CONNECTION_NAME hace que el comando se rechace.
# Vacío: ejecución local sin Cloud SQL.
DB_BOOTSTRAP_ALLOW_HOST=
DB_BOOTSTRAP_EXPECT_INSTANCE=