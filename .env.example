DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Identidad Canary (headers X-Api-Version / X-Api-Track). Vacío → "unset".
# No usar package.json. En Cloud Run: API_VERSION=3.0.1|4.0.0 y API_TRACK=stable|canary.
API_VERSION=
API_TRACK=

# Bootstrap de esquema. No lo ejecuta el arranque de la API.
# plan es de solo lectura. apply y adopt exigen --confirm con el mismo DB_NAME.
# DB_BOOTSTRAP_ALLOW_HOST debe ser exactamente DB_HOST.
# CLOUD_SQL_CONNECTION_NAME hace que el comando se rechace.
DB_BOOTSTRAP_ALLOW_HOST=