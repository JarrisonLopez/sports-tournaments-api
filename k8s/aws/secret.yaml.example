# Copiar a secret.yaml (gitignore) o crear con kubectl create secret.
apiVersion: v1
kind: Secret
metadata:
  name: sports-api-secrets
  namespace: sports-lab
type: Opaque
stringData:
  DB_PASSWORD: "cambiar-en-lab"
  MYSQL_ROOT_PASSWORD: "cambiar-root-lab"
  CHAOS_FAULT_TOKEN: "cambiar-token-minimo-32-caracteres-lab"
